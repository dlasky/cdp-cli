{
  "name": "@dlasky/cdp-cli",
  "version": "1.0.0",
  "description": "CLI for Chrome DevTools Protocol - optimized for LLM agents with NDJSON output",
  "type": "module",
  "bin": {
    "cdp-cli": "build/index.js"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && node scripts/make-executable.mjs",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "prepack": "npm run build",
    "start": "npm run build && node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "keywords": [
    "chrome",
    "devtools",
    "cdp",
    "cli",
    "automation",
    "llm",
    "ndjson",
    "helium"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlasky/cdp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/dlasky/cdp-cli/issues"
  },
  "homepage": "https://github.com/dlasky/cdp-cli#readme",
  "files": [
    "build/**/*",
    "README.md"
  ],
  "dependencies": {
    "sharp": "^0.34.5",
    "undici": "^6.22.0",
    "ws": "^8.18.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.3",
    "@types/sharp": "^0.31.1",
    "@types/ws": "^8.5.13",
    "@types/yargs": "^17.0.33",
    "@vitest/ui": "^4.0.3",
    "c8": "^10.1.3",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.2",
    "vitest": "^4.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
